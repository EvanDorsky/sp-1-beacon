/*
 * download.overlay — DEV-ONLY DT overlay for the module flasher build.
 *
 * The flasher drives uart0 in POLL mode and owns the module's CTS line (P1.01)
 * as a plain GPIO for the download strap, so the UARTE must NOT do hardware
 * flow control (its CTS gating would stall poll TX). Disable it here; the
 * normal runtime build keeps hw-flow-control in app.overlay. (findings.md:
 * the burner-proven download flow uses flow_ctrl = none.)
 */
&uart0 {
    /delete-property/ hw-flow-control;
};

/*
 * DEV-ONLY console flow control. printk on this board goes through the UART
 * console -> uart_poll_out on cdc_acm_uart0, one char at a time. With no
 * flow control, cdc_acm_poll_out() DISCARDS bytes the instant its tx ring
 * fills (usbd_cdc_acm.c: "Ring buffer full, discard data") — the ~450-byte
 * dump stall. Setting hw-flow-control makes poll_out BLOCK (k_msleep) until
 * the ring drains: lossless, just slower. A bigger ring cuts the block-spin.
 *
 * SAFE for dev builds only: if nothing reads the port, poll_out blocks and
 * the ~8 s WDT resets us (feed_wdt runs before the blocking printk each
 * chunk) — recoverable. The shipping runtime build must NOT enable this
 * (the field beacon has no host reading the console -> would WDT-loop).
 */
&cdc_acm_uart0 {
    hw-flow-control;
    tx-fifo-size = <8192>;   /* 8x the 1024 default; static SRAM, dev-only, RAM is cheap here */
};
