#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    zephyr,user {
        /* idx: 0=ladder tracks(AIN0), 1=ladder vol(AIN1), 2..5=faders1..4
         * (AIN3,6,2,7), 6=battery(AIN4) — the looper's verified map, same
         * order as feldd. */
        io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>, <&adc 5>, <&adc 6>;
    };
    chosen { zephyr,console = &cdc_acm_uart0; };
};

&pinctrl {
    /* CYW20706 module WICED-HCI UART (module_link.c). Pins captured on real
     * hardware (bluetooth/hardware-and-architecture.md §1):
     *   nRF TX P1.02 -> module RX,  nRF RX P1.04 <- module TX,
     *   nRF CTS P1.03 <- module RTS (real UARTE flow control).
     * DELIBERATELY NOT pselled: UART_RTS on P1.01 (-> module CTS). That line
     * is the boot-ROM DOWNLOAD-MODE strap (low across a reset release), so
     * module_link.c drives it as a plain GPIO: high through every normal boot,
     * low afterwards so the module may transmit. Mirrors feldd's bt_link
     * "CTS-only hw-flow-control" rule. */
    uart0_default: uart0_default {
        group1 { psels = <NRF_PSEL(UART_TX, 1, 2)>, <NRF_PSEL(UART_CTS, 1, 3)>; };
        group2 { psels = <NRF_PSEL(UART_RX, 1, 4)>; bias-pull-up; };
    };
    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 2)>, <NRF_PSEL(UART_CTS, 1, 3)>,
                    <NRF_PSEL(UART_RX, 1, 4)>;
            low-power-enable;
        };
    };

    /* LED PWM (mirrors the gold sp1-midi BSP stem_player-pinctrl.dtsi).
     * PWM2 = track row, PWM3 = side/play row. Channel->pin per the CANONICAL
     * LED map in sp1_board.h. */
    pwm2_default: pwm2_default { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 29)>,   /* T1 P0.29 */
                <NRF_PSEL(PWM_OUT1, 0, 26)>,   /* T2 P0.26 */
                <NRF_PSEL(PWM_OUT2, 1, 15)>,   /* T3 P1.15 */
                <NRF_PSEL(PWM_OUT3, 1, 14)>;   /* T4 P1.14 */
    }; };
    pwm2_sleep: pwm2_sleep { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 29)>, <NRF_PSEL(PWM_OUT1, 0, 26)>,
                <NRF_PSEL(PWM_OUT2, 1, 15)>, <NRF_PSEL(PWM_OUT3, 1, 14)>;
        low-power-enable;
    }; };
    pwm3_default: pwm3_default { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 1)>,    /* PLAY1 P0.01 */
                <NRF_PSEL(PWM_OUT1, 1, 12)>,   /* PLAY2 P1.12 */
                <NRF_PSEL(PWM_OUT2, 0, 0)>,    /* PLAY3 P0.00 */
                <NRF_PSEL(PWM_OUT3, 1, 13)>;   /* PLAY4 P1.13 (== SP1_LED1) */
    }; };
    pwm3_sleep: pwm3_sleep { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 1)>, <NRF_PSEL(PWM_OUT1, 1, 12)>,
                <NRF_PSEL(PWM_OUT2, 0, 0)>, <NRF_PSEL(PWM_OUT3, 1, 13)>;
        low-power-enable;
    }; };
};

/* CYW20706 module link UART. 115200 8N1, the module's default framing.
 * hw-flow-control with a CTS-only pinctrl: TX pauses when the module deasserts
 * its RTS; the reverse direction (module CTS) is module_link.c's GPIO. */
&uart0 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <115200>;
    hw-flow-control;
    pinctrl-0 = <&uart0_default>; pinctrl-1 = <&uart0_sleep>; pinctrl-names = "default","sleep";
};

/* Enable the two PWM peripherals that drive the 8 LEDs. ~1 kHz, active-high
 * normal polarity, so duty% == LED brightness. */
&pwm2 {
    status = "okay";
    pinctrl-0 = <&pwm2_default>; pinctrl-1 = <&pwm2_sleep>; pinctrl-names = "default","sleep";
};
&pwm3 {
    status = "okay";
    pinctrl-0 = <&pwm3_default>; pinctrl-1 = <&pwm3_sleep>; pinctrl-names = "default","sleep";
};

/ {
    /* pwm-leds container (gold-BSP pattern). led.c references these child
     * labels in FIXED order: idx 0..3 = track T1..T4, idx 4..7 = side/play
     * LED1..4 (see the CANONICAL LED map in sp1_board.h). */
    feldd_leds: feldd-leds {
        compatible = "pwm-leds";
        fled_t1: fled_t1 { pwms = <&pwm2 0 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T1 P0.29 */
        fled_t2: fled_t2 { pwms = <&pwm2 1 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T2 P0.26 */
        fled_t3: fled_t3 { pwms = <&pwm2 2 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T3 P1.15 */
        fled_t4: fled_t4 { pwms = <&pwm2 3 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T4 P1.14 */
        fled_p1: fled_p1 { pwms = <&pwm3 0 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY1 P0.01 */
        fled_p2: fled_p2 { pwms = <&pwm3 1 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY2 P1.12 */
        fled_p3: fled_p3 { pwms = <&pwm3 2 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY3 P0.00 */
        fled_p4: fled_p4 { pwms = <&pwm3 3 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY4 P1.13 */
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    channel@0 { reg=<0>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN0>; zephyr,resolution=<12>; };   /* ladder: tracks */
    channel@1 { reg=<1>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN1>; zephyr,resolution=<12>; };   /* ladder: vol */
    channel@2 { reg=<2>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN3>; zephyr,resolution=<12>; };   /* fader1 P0.05 */
    channel@3 { reg=<3>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN6>; zephyr,resolution=<12>; };   /* fader2 P0.30 */
    channel@4 { reg=<4>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN2>; zephyr,resolution=<12>; };   /* fader3 P0.04 */
    channel@5 { reg=<5>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN7>; zephyr,resolution=<12>; };   /* fader4 P0.31 */
    channel@6 { reg=<6>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN4>; zephyr,resolution=<12>; };   /* battery P0.28 */
};

/* The nRF52840 USB device-controller nodelabel is &usbd; there is no
 * zephyr_udc0 alias on this SoC. The sample_usbd helper (sample_usbd_init.c)
 * hard-references DT_NODELABEL(zephyr_udc0), so we attach that extra label
 * here and hang the CDC-ACM console child node off it. */
zephyr_udc0: &usbd {
    status = "okay";
    cdc_acm_uart0: cdc_acm_uart0 { compatible = "zephyr,cdc-acm-uart"; };
};
