# Zephyr / NCS build + SDK workspace
.zephyr-ws/
build/
*.bin
*.elf
*.hex
*.o

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Vendor-derived, DO NOT COMMIT: the generated CYW20706 blobs (Infineon
# minidriver + Cypress-derived DS image) embedded by the M4 flasher build.
firmware/app/src/cybt_blobs.h
# And any radio hex inputs, if copied into the tree.
*.hcd

# feldd-cc: the user's runtime config is personal (the example is tracked)
feldd-cc/feldd_cc.config.json

# Compiled host-test binaries (built by firmware/test/Makefile): ignore the
# extensionless test_* executables, keep the test_*.c sources tracked.
firmware/test/test_*
!firmware/test/test_*.c
